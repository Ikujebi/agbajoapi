# ==========================================
# Dependencies
# ==========================================
/node_modules
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ==========================================
# NestJS & TypeScript Build Output
# ==========================================
/dist/
/coverage/
*.tsbuildinfo

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Database & Prisma ORM
# ==========================================
# Exclude SQLite local databases or temporary files
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# ==========================================
# Logs & Debugging
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ==========================================
# IDEs & OS System Files
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo

# ==========================================
# Cache & Temporary Files
# ==========================================
/.eslintcache
/.swc
node_modules/
dist/
